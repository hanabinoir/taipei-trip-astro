---
interface Props {
  id: string;
  kicker: string;
  heading: string;
  subHeading: string;
}

const { id, kicker, heading, subHeading } = Astro.props;
---

<!-- <div class="section-heading">
  <div>
    <p class="section-kicker">台北に到着</p>
    <h2 id={id}>
      台湾桃園国際空港 <span>Taiwan Taoyuan Airport</span>
    </h2>
  </div>
</div> -->
<div class="section-heading">
  <div>
    <p class="section-kicker">{kicker}</p>
    <h2 id={id}>
      {heading} <span>{subHeading}</span>
    </h2>
  </div>
</div>

<style>
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .section-kicker {
    margin: 0 0 9px;
    color: #78877f;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  h2 {
    margin: 0;
    color: #1d3029;
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    letter-spacing: -0.035em;
  }

  h2 span {
    margin-left: 8px;
    color: #839087;
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0;
  }

  @media (max-width: 760px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
