---
import Layout from "../layouts/Layout.astro";
import RegionsMap from "../components/RegionsMap.tsx";
import { cities, spots, type CityKey } from "../data/spots";

const cityKeys = Object.keys(cities) as CityKey[];
---

<Layout title="Overview | 北台灣旅行" currentPage="overview">
  <main class="home">
    <header class="intro">
      <p class="eyebrow">MY TRAVEL JOURNAL</p>
      <h1>北台灣，慢慢走</h1>
      <p class="description">點選地圖上的區域，看看每座城市的旅行足跡。</p>
    </header>

    <section class="map-card" aria-label="北台灣旅行地圖">
      <RegionsMap client:load />
      <p class="attribution">
        行政區界線資料：
        <a href="https://github.com/g0v/twgeojson" target="_blank" rel="noreferrer">g0v/twgeojson</a>
      </p>
    </section>

    <nav class="city-list" aria-label="依城市瀏覽旅行地圖">
      {cityKeys.map((key) => {
        const city = cities[key];
        const count = spots.filter((spot) => spot.city === key).length;

        return (
          <a class="city-link" href={`/spots/${key}`} style={`--city-color: ${city.color}`}>
            <span class="city-dot" aria-hidden="true"></span>
            <span class="city-name">{city.name}</span>
            <span class="spot-count">{count} 個景點</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        );
      })}
    </nav>
  </main>
</Layout>

<style>
  .home {
    width: min(100% - 40px, 1080px);
    margin: 48px auto 80px;
  }

  .intro {
    margin-bottom: 28px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: #64736d;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    color: #1d3029;
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: 0.04em;
  }

  .description {
    margin: 12px 0 0;
    color: #65726d;
    font-size: 1rem;
  }

  .map-card {
    overflow: hidden;
    padding: 14px;
    border: 1px solid #e3e9e5;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 16px 48px rgb(34 58 47 / 8%);
  }

  .attribution {
    margin: 10px 6px 2px;
    color: #89948f;
    font-size: 0.75rem;
    text-align: right;
  }

  .attribution a {
    color: inherit;
  }

  .city-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: 20px;
  }

  .city-link {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 16px;
    border: 1px solid #e3e9e5;
    border-radius: 14px;
    color: #283932;
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .city-link:hover {
    transform: translateY(-2px);
    border-color: var(--city-color);
  }

  .city-link:focus-visible {
    outline: 3px solid var(--city-color);
    outline-offset: 3px;
  }

  .city-dot {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--city-color);
  }

  .city-name {
    font-weight: 700;
  }

  .spot-count {
    overflow: hidden;
    margin-left: auto;
    color: #78847e;
    font-size: 0.8rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arrow {
    color: var(--city-color);
  }

  @media (max-width: 720px) {
    .home {
      width: min(100% - 28px, 560px);
      margin-top: 32px;
    }

    .city-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .city-link {
      flex-wrap: wrap;
      gap: 7px;
      padding: 13px;
    }

    .spot-count {
      width: 100%;
      margin-left: 17px;
    }

    .arrow {
      margin-left: auto;
    }
  }
</style>
