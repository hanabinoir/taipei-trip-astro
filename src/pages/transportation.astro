---
import Layout from "../layouts/Layout.astro";
import Text from "../components/Text.astro";
import TransportationMap from "../components/TransportationMap";
import BusesMapTable from "../components/BusesMapTable";
---

<Layout title="Transportation | 北台灣旅行" currentPage="transportation">
  <main class="transport-page">
    <header class="page-heading">
      <p class="eyebrow"><Text path="eyebrow" /></p>
      <h1><Text path="title" /></h1>
      <p class="page-intro"><Text path="intro" /></p>
    </header>

    <!-- Section 1: TPE -->
    <section class="transport-section tpe-section" aria-labelledby="tpe-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker"><Text path="section1.kicker" /></p>
          <h2 id="tpe-heading"><Text path="section1.heading" /> <span><Text path="section1.subHeading" /></span></h2>
        </div>
      </div>

      <div class="tpe-map-wrapper">
        <TransportationMap
          client:visible
          markers={[
            {
              code: "TPE",
              name: "Taiwan Taoyuan International Airport",
              localName: "桃園國際機場",
              coordinates: [121.2342, 25.0797],
              color: "#315d4a",
            },
            {
              code: "A1",
              name: "Taipei Main Station",
              localName: "台北車站",
              coordinates: [121.5301, 25.0456],
              color: "#315d4a",
            },
            {
              code: "A23",
              name: "Zhongli Station",
              localName: "中壢車站",
              coordinates: [121.2194, 24.9568],
              color: "#315d4a",
            },
          ]}
          ariaLabel="桃園機場、台北車站與中壢車站位置地圖"
        />
      </div>

      <div class="tpe-roadmap-info-container">
        <a class="roadmap-link" href="https://www.tymetro.com.tw/tymetro-new/jp/_pages/travel-guide/road.html" target="_blank" rel="noreferrer">
          <div class="roadmap-container">
            <img
              src="/images/transportation/airport_road_02-1_big.png"
              alt="桃園機場捷運路線圖 - 點擊開啟原始圖片"
              class="roadmap-image"
            />
            <span class="roadmap-open-icon" aria-hidden="true">↗</span>
          </div>
        </a>

        <div class="tpe-info-grid">
          <article class="tpe-card">
            <div class="card-title">
              <span class="airport-code">A1</span>
              <span class="airport-type"><Text path="section1.card2Type" /></span>
            </div>
            <h3><Text path="section1.card2Title" /></h3>
            <p><Text path="section1.card2Desc" /></p>
          </article>

          <article class="tpe-card">
            <div class="card-title">
              <span class="airport-code">TPE</span>
              <span class="airport-type"><Text path="section1.card1Type" /></span>
            </div>
            <h3><Text path="section1.card1Title" /></h3>
            <p><Text path="section1.card1Desc" /></p>
          </article>

          <article class="tpe-card">
            <div class="card-title">
              <span class="airport-code">A23</span>
              <span class="airport-type"><Text path="section1.card3Type" /></span>
            </div>
            <h3><Text path="section1.card3Title" /></h3>
            <p><Text path="section1.card3Desc" /></p>
          </article>
        </div>
      </div>
    </section>

    <!-- Section 2: Taipei Metro & TSA -->
    <section class="transport-section metro-tsa-section" aria-labelledby="metro-tsa-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker"><Text path="section2.kicker" /></p>
          <h2 id="metro-tsa-heading"><Text path="section2.heading" /> <span><Text path="section2.subHeading" /></span></h2>
        </div>
      </div>

      <div class="metro-map-wrapper">
        <TransportationMap
          client:visible
          markers={[
            {
              code: "TSA",
              name: "Taipei Songshan Airport",
              localName: "台北松山機場",
              coordinates: [121.5525, 25.0697],
              color: "#b57b45",
            },
            {
              name: "Taipei 101",
              localName: "台北101",
              coordinates: [121.5645, 25.0330],
              color: "#b57b45",
            },
          ]}
          center={[121.56, 25.05]}
          zoom={11.5}
          ariaLabel="台北松山機場與台北101位置地圖"
        />
      </div>

      <div class="metro-roadmap-info-container">
        <a class="roadmap-link" href="https://www.travel.taipei/ja/information/mrt" target="_blank" rel="noreferrer">
          <div class="roadmap-container">
            <img
              src="/images/transportation/taipei_roadmap2026-jp.png"
              alt="台北捷運路線圖 2026 - 點擊開啟原始頁面"
              class="roadmap-image"
            />
            <span class="roadmap-open-icon" aria-hidden="true">↗</span>
          </div>
        </a>

        <div class="metro-info-grid"><article class="info-card">
            <span class="card-icon" aria-hidden="true">◎</span>
            <div>
              <h3><Text path="section2.keyStations" /> <span><Text path="section2.keyStationsEn" /></span></h3>
              <ul class="station-list">
                <li><strong><Text path="section2.station1Name" /></strong><span><Text path="section2.station1Desc" /></span></li>
                <li><strong><Text path="section2.station2Name" /></strong><span><Text path="section2.station2Desc" /></span></li>
                <li><strong><Text path="section2.station3Name" /></strong><span><Text path="section2.station3Desc" /></span></li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Section 3: Intercity Buses -->
    <section class="transport-section buses-section" aria-labelledby="buses-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker"><Text path="section3.kicker" /></p>
          <h2 id="buses-heading"><Text path="section3.heading" /> <span><Text path="section3.subHeading" /></span></h2>
        </div>
      </div>

      <div class="buses-grid">
        <article class="buses-card">
          <span class="buses-symbol" aria-hidden="true">🚌</span>
          <div class="buses-card-copy">
            <h3><Text path="section3.busesTitle" /></h3>
            <small><Text path="section3.busesDesc" /></small>
          </div>
        </article>
      </div>

      <BusesMapTable client:visible ariaLabel="Bus routes to major destinations in Taipei area" />
    </section>

    <!-- Section 4: Motorcycles -->
    <section class="transport-section motorcycles-section" aria-labelledby="motorcycles-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker"><Text path="section4.kicker" /></p>
          <h2 id="motorcycles-heading"><Text path="section4.heading" /> <span><Text path="section4.subHeading" /></span></h2>
        </div>
      </div>

      <div class="motorcycles-grid">
        <article class="motorcycles-card">
          <div class="motorcycles-card-copy">
            <h3><Text path="section4.bikeFall" /></h3>
            <small><Text path="section4.bikeFallDesc" /></small>
          </div>
          <div class="motorcycles-image-wrapper">
            <img src="/images/transportation/taipei-bike-flow.jpeg" alt="台北橋機車瀑布" class="motorcycles-image" />
          </div>
        </article>

        <article class="motorcycles-card">
          <div class="motorcycles-card-copy">
            <h3><Text path="section4.parkingArea" /></h3>
            <small><Text path="section4.parkingAreaDesc" /></small>
          </div>
          <div class="motorcycles-image-wrapper">
            <img src="/images/transportation/taipei-bike-park.jpg" alt="騎樓停車" class="motorcycles-image" />
          </div>
        </article>
      </div>
    </section>

    <!-- Section 5: Payment -->
    <section class="transport-section payment-section" aria-labelledby="payment-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker"><Text path="section5.kicker" /></p>
          <h2 id="payment-heading"><Text path="section5.heading" /> <span><Text path="section5.subHeading" /></span></h2>
        </div>
      </div>

      <div class="payment-grid">
        <article class="payment-card">
          <div class="payment-image-wrapper">
            <img src="/images/transportation/easy_card.jpg" alt="悠遊卡" class="payment-image" />
          </div>
          <div class="payment-card-copy">
            <h3><Text path="section5.easycard" /></h3>
            <small><Text path="section5.easycardDesc" /></small>
          </div>
        </article>

        <article class="payment-card">
          <span class="payment-symbol" aria-hidden="true">🎫</span>
          <div class="payment-card-copy">
            <h3><Text path="section5.klook" /></h3>
            <small><Text path="section5.klookDesc" /></small>
          </div>
          <a class="payment-link" href="https://www.klook.com/" target="_blank" rel="noreferrer">
            <Text path="section5.klookLink" /> <span aria-hidden="true">↗</span>
          </a>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  .transport-page {
    width: min(100% - 40px, 1080px);
    margin: 60px auto 88px;
  }

  .page-heading {
    margin-bottom: 48px;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 9px;
    color: #78877f;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1 {
    margin: 0;
    color: #1d3029;
    font-size: clamp(2.4rem, 6vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .page-intro {
    max-width: 600px;
    margin: 16px 0 0;
    color: #66746d;
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .transport-section {
    margin-top: 64px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .section-heading h2 {
    margin: 0;
    color: #1d3029;
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    letter-spacing: -0.035em;
  }

  .section-heading h2 span {
    margin-left: 8px;
    color: #839087;
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0;
  }

  .section-heading > p {
    max-width: 390px;
    margin: 0 0 4px;
    color: #78847e;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  /* TPE Section styles */
  .tpe-map-wrapper {
    min-height: 400px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #e4e9e5;
    background: #fff;
    box-shadow: 0 14px 40px rgb(34 58 47 / 4%);
    margin: 24px 0;
  }

  .tpe-roadmap-info-container {
    display: grid;
    grid-template-columns: 550px 1fr;
    gap: 24px;
    margin: 24px 0;
    align-items: stretch;
  }

  .tpe-roadmap-info-container .roadmap-link {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .tpe-roadmap-info-container .roadmap-container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .tpe-roadmap-info-container .roadmap-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-height: none;
  }

  .roadmap-link {
    display: block;
    position: relative;
    text-decoration: none;
  }

  .roadmap-link:hover .roadmap-open-icon {
    opacity: 1;
    transform: scale(1.1);
  }

  .roadmap-container {
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #e4e9e5;
    background: #fff;
    box-shadow: 0 14px 40px rgb(34 58 47 / 4%);
    position: relative;
  }

  .roadmap-image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 600px;
    object-fit: cover;
  }

  .roadmap-open-icon {
    position: absolute;
    bottom: 12px;
    right: 12px;
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    background: rgba(49, 93, 74, 0.9);
    color: white;
    border-radius: 8px;
    font-size: 1.1rem;
    opacity: 0;
    transition: opacity 200ms ease, transform 200ms ease;
    z-index: 10;
  }

  .tpe-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .tpe-card {
    padding: 24px;
    border: 1px solid #e4e9e5;
    background: #fff;
    box-shadow: 0 14px 40px rgb(34 58 47 / 4%);
    border-radius: 18px;
  }

  .tpe-card h3 {
    margin: 12px 0 7px;
    color: #263a32;
    font-size: 1.07rem;
  }

  .tpe-card p {
    margin: 0;
    color: #728078;
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .card-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .airport-code {
    display: inline-flex;
    min-width: 43px;
    justify-content: center;
    padding: 5px 8px;
    border-radius: 7px;
    background: #edf3ee;
    color: #315d4a;
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.08em;
  }

  .airport-type {
    color: #849088;
    font-size: 0.76rem;
  }

  /* Metro TSA Section styles */
  .metro-map-wrapper {
    min-height: 400px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #e4e9e5;
    background: #fff;
    box-shadow: 0 14px 40px rgb(34 58 47 / 4%);
    margin: 24px 0;
  }

  .metro-roadmap-info-container {
    display: grid;
    grid-template-columns: 550px 1fr;
    gap: 24px;
    margin: 24px 0;
    align-items: stretch;
  }

  .metro-roadmap-info-container .roadmap-link {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .metro-roadmap-info-container .roadmap-container {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .metro-roadmap-info-container .roadmap-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    max-height: none;
  }

  .metro-info-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .info-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 24px;
    border: 1px solid #e4e9e5;
    background: #fff;
    box-shadow: 0 14px 40px rgb(34 58 47 / 4%);
    border-radius: 18px;
  }

  .info-card h3 {
    margin: 1px 0 8px;
    color: #263a32;
    font-size: 1.07rem;
  }

  .info-card h3 span {
    margin-left: 5px;
    color: #839087;
    font-size: 0.8em;
    font-weight: 600;
  }

  .info-card p {
    margin: 0;
    color: #728078;
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .card-icon {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    place-items: center;
    border-radius: 13px;
    background: #edf3ee;
    color: #315d4a;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .station-list {
    display: grid;
    gap: 12px;
    margin: 13px 0 0;
    padding: 0;
    list-style: none;
  }

  .station-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    color: #728078;
    font-size: 0.81rem;
    line-height: 1.5;
  }

  .station-list strong {
    min-width: 90px;
    color: #30453b;
    font-size: 0.86rem;
  }

  /* Other Transportation styles */
  .other-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 20px;
  }

  .other-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
    padding: 20px;
    border: 1px solid #e4e9e5;
    background: #fff;
    box-shadow: 0 14px 40px rgb(34 58 47 / 4%);
    border-radius: 15px;
    color: inherit;
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .other-card:hover {
    transform: translateY(-2px);
    border-color: #b9cabf;
  }

  .other-symbol {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    place-items: center;
    border-radius: 12px;
    background: #edf3ee;
    color: #315d4a;
    font-size: 1.3rem;
  }

  .other-card-copy {
    min-width: 0;
  }

  .other-card-copy h3 {
    margin: 0;
    color: #263a32;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .other-card-copy small {
    display: block;
    margin-top: 4px;
    color: #87928b;
    font-size: 0.75rem;
  }

  .other-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    color: #315d4a;
    font-size: 0.82rem;
    font-weight: 750;
    text-decoration: none;
  }

  .other-link:hover {
    color: #173d2b;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 15px;
    color: #315d4a;
    font-size: 0.84rem;
    font-weight: 750;
    text-decoration: none;
  }

  .text-link:hover {
    color: #173d2b;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .transport-page a:focus-visible {
    outline: 3px solid #7da78e;
    outline-offset: 3px;
  }

  @media (max-width: 1024px) {
    .tpe-roadmap-info-container,
    .metro-roadmap-info-container {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .transport-page {
      width: min(100% - 28px, 580px);
      margin-top: 42px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .tpe-info-grid,
    .metro-info-grid {
      grid-template-columns: 1fr;
    }

    .other-grid {
      grid-template-columns: 1fr;
    }

    .roadmap-image {
      max-height: 400px;
    }

    .tpe-map-wrapper,
    .metro-map-wrapper {
      min-height: 300px;
    }
  }

  @media (max-width: 430px) {
    .info-card {
      gap: 12px;
      padding: 18px;
    }

    .card-icon {
      width: 36px;
      height: 36px;
      flex-basis: 36px;
    }

    .other-card {
      padding: 16px;
    }

    .tpe-info-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
