---
import Layout from "../layouts/Layout.astro";
import TransportationMap from "../components/TransportationMap";
---

<Layout title="Transportation | 北台灣旅行" currentPage="transportation">
  <main class="transport-page">
    <header class="page-heading">
      <p class="eyebrow">GETTING AROUND</p>
      <h1>Transportation</h1>
      <p class="page-intro">從機場進城，到城市間移動，整理北台灣常用的交通方式與官方資訊。</p>
    </header>

    <section class="transport-section airports" aria-labelledby="airports-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">ARRIVE IN TAIPEI</p>
          <h2 id="airports-heading">Airports <span>機場</span></h2>
        </div>
        <p>先確認機票上的機場代碼，再安排接駁。</p>
      </div>

      <TransportationMap client:visible />

      <div class="airport-grid">
        <article class="airport-card">
          <div class="photo-placeholder" role="img" aria-label="桃園國際機場照片待補">
            <span class="placeholder-icon" aria-hidden="true">✦</span>
            <span>桃園國際機場照片待補</span>
          </div>
          <div class="airport-copy">
            <div class="card-title-row">
              <span class="airport-code">TPE</span>
              <span class="airport-type">桃園 · 國際線</span>
            </div>
            <h3>Taiwan Taoyuan International Airport</h3>
            <p>主要國際門戶，可搭桃園機場捷運、客運或計程車往返市區。</p>
            <a class="text-link" href="https://web.taoyuan-airport.com/transportation?lang=en" target="_blank" rel="noreferrer">
              官方交通資訊 <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <article class="airport-card">
          <div class="photo-placeholder photo-placeholder-city" role="img" aria-label="台北松山機場照片待補">
            <span class="placeholder-icon" aria-hidden="true">✦</span>
            <span>台北松山機場照片待補</span>
          </div>
          <div class="airport-copy">
            <div class="card-title-row">
              <span class="airport-code">TSA</span>
              <span class="airport-type">台北市 · 市區機場</span>
            </div>
            <h3>Taipei Songshan Airport</h3>
            <p>位於台北市區，可轉乘台北捷運文湖線與市區公車。</p>
            <a class="text-link" href="https://www.tsa.gov.tw/" target="_blank" rel="noreferrer">
              松山機場官網 <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      </div>
    </section>

    <section class="transport-section" aria-labelledby="metro-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">CITY TRANSIT</p>
          <h2 id="metro-heading">Metro <span>捷運</span></h2>
        </div>
        <p>查詢路線圖與營運資訊，出發前確認末班車時間。</p>
      </div>

      <div class="metro-grid">
        <article class="info-card route-card">
          <span class="card-icon" aria-hidden="true">↗</span>
          <div>
            <h3>Routes <span>路線圖</span></h3>
            <p>台北捷運與桃園機場捷運官方路線及乘車資訊。</p>
            <div class="link-row">
              <a class="text-link" href="https://english.metro.taipei/" target="_blank" rel="noreferrer">Taipei Metro official map <span aria-hidden="true">↗</span></a>
              <a class="text-link" href="https://www.tymetro.com.tw/tymetro-new/en/_pages/travel-guide/index.php?gotime=11%3A30" target="_blank" rel="noreferrer">Taoyuan Metro trip planner <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </article>

        <article class="info-card station-card">
          <span class="card-icon" aria-hidden="true">◎</span>
          <div>
            <h3>Stations <span>交通樞紐</span></h3>
            <ul class="station-list">
              <li><strong>Taipei</strong><span>台北車站｜市區捷運、台鐵與高鐵轉乘</span></li>
              <li><strong>Banqiao / Itabashi</strong><span>板橋｜捷運、台鐵與高鐵轉乘</span></li>
              <li><strong>Zhongli</strong><span>中壢｜桃園市區交通與鐵道接駁</span></li>
            </ul>
          </div>
        </article>
      </div>
    </section>

    <section class="transport-section" aria-labelledby="bus-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">INTERCITY COACH</p>
          <h2 id="bus-heading">Highway Buses <span>國道客運</span></h2>
        </div>
        <p>適合跨縣市移動；路線、班次與預約依業者公告為準。</p>
      </div>
      <div class="bus-content">
        <div class="operator-list">
          <a class="operator-card" href="https://www.kingbus.com.tw/" target="_blank" rel="noreferrer">
            <span class="operator-monogram">國</span>
            <span><strong>國光客運</strong><small>Kuo-Kuang Motor Transport</small></span>
            <span class="external-mark" aria-hidden="true">↗</span>
          </a>
          <a class="operator-card" href="https://www.ubus.com.tw/" target="_blank" rel="noreferrer">
            <span class="operator-monogram">統</span>
            <span><strong>統聯客運</strong><small>Ubus</small></span>
            <span class="external-mark" aria-hidden="true">↗</span>
          </a>
        </div>
        <aside class="reservation-card">
          <p class="section-kicker">PLAN AHEAD</p>
          <h3>預約與行程</h3>
          <p>可至客運業者官網查詢班次，也可查看 Klook 的交通票券選項。</p>
          <a class="text-link" href="https://www.klook.com/zh-TW/transport/" target="_blank" rel="noreferrer">
            在 Klook 查看交通票券 <span aria-hidden="true">↗</span>
          </a>
        </aside>
      </div>
    </section>

    <section class="transport-section other-section" aria-labelledby="other-heading">
      <div class="section-heading">
        <div>
          <p class="section-kicker">MORE WAYS TO GO</p>
          <h2 id="other-heading">Others <span>其他交通</span></h2>
        </div>
      </div>
      <div class="other-grid">
        <a class="other-card" href="https://www.thsrc.com.tw/" target="_blank" rel="noreferrer">
          <span class="other-symbol" aria-hidden="true">↗</span>
          <span class="other-card-copy"><strong>HSR</strong><small>台灣高鐵｜時刻表與訂票</small></span>
          <span class="external-mark" aria-hidden="true">↗</span>
        </a>
        <a class="other-card" href="https://www.railway.gov.tw/tra-tip-web/tip?lang=EN_US" target="_blank" rel="noreferrer">
          <span class="other-symbol" aria-hidden="true">⇄</span>
          <span class="other-card-copy"><strong>TR</strong><small>台灣鐵路｜列車時刻與訂票</small></span>
          <span class="external-mark" aria-hidden="true">↗</span>
        </a>
        <a class="other-card" href="https://www.youbike.com.tw/region/main/" target="_blank" rel="noreferrer">
          <span class="other-symbol" aria-hidden="true">⌁</span>
          <span class="other-card-copy"><strong>Bike</strong><small>YouBike｜站點與即時車況</small></span>
          <span class="external-mark" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .transport-page {
    width: min(100% - 40px, 1080px);
    margin: 60px auto 88px;
  }

  .page-heading {
    margin-bottom: 48px;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 9px;
    color: #78877f;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  h1 {
    margin: 0;
    color: #1d3029;
    font-size: clamp(2.4rem, 6vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .page-intro {
    max-width: 600px;
    margin: 16px 0 0;
    color: #66746d;
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .transport-section {
    margin-top: 64px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
  }

  .section-heading h2 {
    margin: 0;
    color: #1d3029;
    font-size: clamp(1.7rem, 4vw, 2.3rem);
    letter-spacing: -0.035em;
  }

  .section-heading h2 span {
    margin-left: 8px;
    color: #839087;
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0;
  }

  .section-heading > p {
    max-width: 390px;
    margin: 0 0 4px;
    color: #78847e;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .airport-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 18px;
  }

  .airport-card,
  .info-card,
  .reservation-card,
  .operator-card,
  .other-card {
    border: 1px solid #e4e9e5;
    background: #fff;
    box-shadow: 0 14px 40px rgb(34 58 47 / 4%);
  }

  .airport-card {
    overflow: hidden;
    border-radius: 18px;
  }

  .photo-placeholder {
    display: flex;
    min-height: 145px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background:
      radial-gradient(ellipse at 75% 15%, rgb(255 255 255 / 82%), transparent 34%),
      linear-gradient(130deg, #dce8df 0%, #edf1e9 52%, #d7e3df 100%);
    color: #718078;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .photo-placeholder-city {
    background:
      radial-gradient(ellipse at 25% 80%, rgb(255 255 255 / 84%), transparent 32%),
      linear-gradient(130deg, #e8e4d8 0%, #f0eee6 52%, #dde8e2 100%);
  }

  .placeholder-icon {
    color: #839b8d;
    font-size: 1.05rem;
  }

  .airport-copy {
    padding: 21px 23px 23px;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .airport-code {
    display: inline-flex;
    min-width: 43px;
    justify-content: center;
    padding: 5px 8px;
    border-radius: 7px;
    background: #edf3ee;
    color: #315d4a;
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.08em;
  }

  .airport-type {
    color: #849088;
    font-size: 0.76rem;
  }

  .airport-copy h3,
  .info-card h3,
  .reservation-card h3 {
    margin: 12px 0 7px;
    color: #263a32;
    font-size: 1.07rem;
  }

  .airport-copy p,
  .info-card p,
  .reservation-card p {
    margin: 0;
    color: #728078;
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 15px;
    color: #315d4a;
    font-size: 0.84rem;
    font-weight: 750;
    text-decoration: none;
  }

  .text-link:hover {
    color: #173d2b;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .metro-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 18px;
  }

  .info-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 24px;
    border-radius: 18px;
  }

  .card-icon,
  .other-symbol {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    place-items: center;
    border-radius: 13px;
    background: #edf3ee;
    color: #315d4a;
    font-size: 1.2rem;
    font-weight: 700;
  }

  .info-card h3 {
    margin: 1px 0 8px;
  }

  .info-card h3 span {
    margin-left: 5px;
    color: #839087;
    font-size: 0.8em;
    font-weight: 600;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
  }

  .station-list {
    display: grid;
    gap: 12px;
    margin: 13px 0 0;
    padding: 0;
    list-style: none;
  }

  .station-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    color: #728078;
    font-size: 0.81rem;
    line-height: 1.5;
  }

  .station-list strong {
    min-width: 78px;
    color: #30453b;
    font-size: 0.86rem;
  }

  .bus-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 18px;
  }

  .operator-list {
    display: grid;
    gap: 12px;
  }

  .operator-card,
  .other-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 17px 19px;
    border-radius: 15px;
    color: inherit;
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .operator-card:hover,
  .other-card:hover {
    transform: translateY(-2px);
    border-color: #b9cabf;
  }

  .operator-monogram {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    place-items: center;
    border-radius: 13px;
    background: #f3efe3;
    color: #796b42;
    font-size: 1.1rem;
    font-weight: 800;
  }

  .operator-card strong,
  .other-card strong {
    display: block;
    color: #263a32;
    font-size: 0.94rem;
  }

  .operator-card small,
  .other-card small {
    display: block;
    margin-top: 4px;
    color: #87928b;
    font-size: 0.75rem;
  }

  .external-mark {
    margin-left: auto;
    color: #839087;
    font-size: 0.95rem;
  }

  .reservation-card {
    padding: 23px;
    border-radius: 18px;
    background: #f1f5f0;
    box-shadow: none;
  }

  .reservation-card h3 {
    margin-top: 0;
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .other-card {
    min-width: 0;
    padding: 17px;
  }

  .other-symbol {
    width: 38px;
    height: 38px;
    flex-basis: 38px;
    font-size: 1rem;
  }

  .other-card-copy {
    min-width: 0;
  }

  .other-card small {
    line-height: 1.4;
  }

  .transport-page a:focus-visible {
    outline: 3px solid #7da78e;
    outline-offset: 3px;
  }

  @media (max-width: 760px) {
    .transport-page {
      width: min(100% - 28px, 580px);
      margin-top: 42px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .airport-grid,
    .metro-grid,
    .bus-content {
      grid-template-columns: 1fr;
    }

    .other-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 430px) {
    .info-card {
      gap: 12px;
      padding: 18px;
    }

    .card-icon {
      width: 36px;
      height: 36px;
      flex-basis: 36px;
    }
  }
</style>
