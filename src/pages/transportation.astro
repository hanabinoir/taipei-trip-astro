---
import Layout from "../layouts/Layout.astro";
import Header from "../components/transportation/Header.astro";
import AirportSection from "../components/transportation/AirportSection.astro";
import MetroSection from "../components/transportation/MetroSection.astro";
import BusesSection from "../components/transportation/BusesSection.astro";
import MotorcyclesSection from "../components/transportation/MotorcyclesSection.astro";
import PaymentSection from "../components/transportation/PaymentSection.astro";
---

<Layout title="Transportation | 北台灣旅行" currentPage="transportation">
  <main class="transport-page">
    <Header />
    <AirportSection />
    <MetroSection />
    <BusesSection />
    <MotorcyclesSection />
    <PaymentSection />
  </main>
</Layout>

<style>
  .transport-page {
    width: min(100% - 40px, 1080px);
    margin: 60px auto 88px;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: anywhere;
  }

  .transport-page a:focus-visible {
    outline: 3px solid #7da78e;
    outline-offset: 3px;
  }
</style>
