---
import Layout from "../layouts/Layout.astro";
import SpotsMap from "../components/SpotsMap.tsx";
---

<Layout title="Spots | 北台灣旅行" currentPage="spots">
  <main class="legacy-map">
    <h1>我的北台灣旅行地圖</h1>
    <SpotsMap client:visible />
  </main>
</Layout>

<style>
  .legacy-map {
    width: min(100% - 40px, 1080px);
    margin: 48px auto 80px;
  }

  h1 {
    margin: 0 0 24px;
    color: #1d3029;
    font-size: clamp(2rem, 5vw, 3.25rem);
  }
</style>
