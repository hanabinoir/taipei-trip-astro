---
import Layout from "../layouts/Layout.astro";
import { sectionsList, getImages, getYoutubeLinks } from "../data/gallery";
import { YouTube } from '@astro-community/astro-embed-youtube';

const sections = sectionsList;
---

<Layout title="Gallery | 北台灣旅行" currentPage="gallery">
  <main class="gallery-page">
    <p class="eyebrow">TRAVEL GALLERY</p>
    <h1>Gallery</h1>

    {sections.map((section) => {
      const images = getImages(section.folder);
      const previewImages = images.slice(0, 3);
      const youtubeLinks = getYoutubeLinks(section.folder);
      const previewYoutubeLinks = youtubeLinks.slice(0, 3);
      const hasMore = images.length > 3 || youtubeLinks.length > 3;

      return (
        <section class="gallery-section" id={section.id}>
          <div class="section-header">
            <h2>{section.label}</h2>
            {hasMore && (
              <a href={`/gallery/${section.id}`} class="show-more-link">
                Show More >>
              </a>
            )}
          </div>

          {images.length === 0 && youtubeLinks.length === 0 && (
            <p class="empty-section">No photos available yet</p>
          )}

          {images.length > 0 && (
            <div class="gallery-grid">
              {previewImages.map((image) => (
                <figure class="gallery-item">
                  <img
                    src={image}
                    alt={`${section.label} - ${image}`}
                    loading="lazy"
                  />
                </figure>
              ))}
            </div>
          )}

          {youtubeLinks.length > 0 && (
            <div class="youtube-links">
              {previewYoutubeLinks.map((link) => (
                <YouTube id={link} />
              ))}
            </div>
          )}
        </section>
      );
    })}
  </main>
</Layout>

<style>
  .gallery-page {
    width: min(100% - 40px, 1080px);
    margin: 64px auto 80px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: #64736d;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0 0 48px;
    color: #1d3029;
    font-size: clamp(2rem, 5vw, 3.25rem);
  }

  .gallery-section {
    margin-bottom: 56px;
  }

  .section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .gallery-section h2 {
    margin: 0;
    color: #1d3029;
    font-size: 1.4rem;
  }

  .show-more-link {
    color: #315d4a;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .show-more-link:hover {
    color: #1d3029;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }

  .gallery-item {
    margin: 0;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 4px 12px rgb(34 58 47 / 8%);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgb(34 58 47 / 12%);
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: cover;
  }

  .empty-section {
    padding: 40px 20px;
    text-align: center;
    color: #69766f;
    background: #fafbf9;
    border-radius: 12px;
    border: 1px solid #e3e9e5;
  }

  .youtube-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }

  .youtube-links > * {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 12px rgb(34 58 47 / 8%);
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .youtube-links > *:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgb(34 58 47 / 12%);
  }

  .youtube-links iframe {
    display: block;
    width: 100%;
    height: 240px;
  }

  @media (max-width: 720px) {
    .gallery-page {
      width: min(100% - 28px, 560px);
      margin-top: 40px;
    }

    h1 {
      margin-bottom: 32px;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 16px;
    }

    .gallery-section h2 {
      font-size: 1.2rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    .gallery-item img {
      height: 180px;
    }

    .youtube-links {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }

    .youtube-links iframe {
      height: 180px;
    }
  }
</style>
