---
import SpotsMap from "./SpotsMap.tsx";
import { cities, spots, type CityKey } from "../data/spots";

interface Props {
  selectedCity?: CityKey;
}

const { selectedCity = "taipei" } = Astro.props;
const orderedCityKeys: CityKey[] = ["taipei", "newtaipei", "taoyuan", "keelung"];
const visibleSpots = spots.filter((spot) => spot.city === selectedCity);
---

<main class="spots-page">
  <header class="intro">
    <p class="eyebrow">TRAVEL SPOTS</p>
    <h1 data-zh-tw="旅行景點" data-ja="旅行スポット">旅行景點</h1>
    <p class="description" data-zh-tw={`探索${cities[selectedCity].name}的旅行足跡。`} data-ja={`${cities[selectedCity].name}の旅行の足跡を探索します。`}>
      探索{cities[selectedCity].name}的旅行足跡。
    </p>
  </header>

  <nav class="city-tabs" aria-label="依城市篩選景點">
    {orderedCityKeys.map((key) => (
      <a
        class:list={["city-tab", { active: selectedCity === key }]}
        href={`/spots/${key}`}
        aria-current={selectedCity === key ? "page" : undefined}
        style={`--city-color: ${cities[key].color}`}
      >
        <span class="city-dot" aria-hidden="true"></span>
        {cities[key].name}
      </a>
    ))}
  </nav>

  <section class="map-card" aria-label="景點地圖">
    <SpotsMap city={selectedCity} client:visible />
  </section>

  <section class="spot-section" aria-labelledby="spot-list-heading">
    <div class="section-heading">
      <h2 id="spot-list-heading" data-zh-tw={`${cities[selectedCity].name}景點`} data-ja={`${cities[selectedCity].name}スポット`}>{cities[selectedCity].name}景點</h2>
      <span data-spot-count={visibleSpots.length}>{visibleSpots.length} 個景點</span>
    </div>
    <ul class="spot-list">
      {visibleSpots.map((spot) => (
        <li>
          <button 
            class="spot-card" 
            type="button" 
            data-spot-slug={spot.slug}
            data-zh-tw={`查看${spot.nameJa}介紹`}
            data-ja={`${spot.name}の紹介を表示`}
            aria-label={`查看${spot.nameJa}介紹`}
          >
            <span class="spot-dot" style={`--city-color: ${cities[spot.city].color}`} aria-hidden="true"></span>
            <span class="spot-name" data-zh-tw={spot.nameJa} data-ja={spot.name}>{spot.nameJa}</span>
          </button>
        </li>
      ))}
    </ul>
  </section>
</main>

<script>
  // Client-side language switching for spot names
  const updateSpotLanguage = () => {
    const currentLang = localStorage.getItem("trip-language") || "zh-TW";
    
    // Update heading
    const heading = document.querySelector("h2[data-zh-tw]");
    if (heading) {
      const zhTw = heading.getAttribute("data-zh-tw");
      const ja = heading.getAttribute("data-ja");
      if (currentLang === "ja" && ja) {
        heading.textContent = ja;
      } else if (zhTw) {
        heading.textContent = zhTw;
      }
    }

    // Update description
    const description = document.querySelector(".description[data-zh-tw]");
    if (description) {
      const zhTw = description.getAttribute("data-zh-tw");
      const ja = description.getAttribute("data-ja");
      if (currentLang === "ja" && ja) {
        description.textContent = ja;
      } else if (zhTw) {
        description.textContent = zhTw;
      }
    }

    // Update h1
    const h1 = document.querySelector("h1[data-zh-tw]");
    if (h1) {
      const zhTw = h1.getAttribute("data-zh-tw");
      const ja = h1.getAttribute("data-ja");
      if (currentLang === "ja" && ja) {
        h1.textContent = ja;
      } else if (zhTw) {
        h1.textContent = zhTw;
      }
    }

    // Update spot names
    document.querySelectorAll(".spot-name[data-zh-tw]").forEach((element) => {
      const zhTw = element.getAttribute("data-zh-tw");
      const ja = element.getAttribute("data-ja");
      if (currentLang === "ja" && ja) {
        element.textContent = ja;
      } else if (zhTw) {
        element.textContent = zhTw;
      }
    });

    // Update spot card aria-labels
    document.querySelectorAll(".spot-card[data-spot-slug]").forEach((button) => {
      const zhTw = button.getAttribute("data-zh-tw");
      const ja = button.getAttribute("data-ja");
      if (currentLang === "ja" && ja) {
        button.setAttribute("aria-label", ja);
      } else if (zhTw) {
        button.setAttribute("aria-label", zhTw);
      }
    });
  };

  // Initial update
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", updateSpotLanguage);
  } else {
    updateSpotLanguage();
  }

  // Listen for language changes
  window.addEventListener("language-change", updateSpotLanguage);
</script>

<style>
  .spots-page {
    width: min(100% - 40px, 1080px);
    margin: 48px auto 80px;
  }

  .intro {
    margin-bottom: 24px;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: #64736d;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h1 {
    margin: 0;
    color: #1d3029;
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: 0.04em;
  }

  .description {
    margin: 12px 0 0;
    color: #65726d;
    font-size: 1rem;
  }

  .city-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 16px;
  }

  .city-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 15px;
    border: 1px solid #e1e7e2;
    border-radius: 999px;
    color: #53625a;
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .city-tab:hover {
    border-color: var(--city-color, #315d4a);
    color: #1d3029;
  }

  .city-tab.active {
    border-color: var(--city-color, #315d4a);
    background: var(--city-color, #315d4a);
    color: #fff;
  }

  .city-tab:focus-visible {
    outline: 3px solid #7da78e;
    outline-offset: 3px;
  }

  .city-dot,
  .spot-dot {
    width: 9px;
    height: 9px;
    flex: 0 0 9px;
    border-radius: 50%;
    background: var(--city-color, #315d4a);
  }

  .map-card {
    overflow: hidden;
    padding: 14px;
    border: 1px solid #e3e9e5;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 16px 48px rgb(34 58 47 / 8%);
  }

  .spot-section {
    margin-top: 32px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .section-heading h2 {
    margin: 0;
    color: #1d3029;
    font-size: 1.25rem;
  }

  .section-heading > span {
    color: #78847e;
    font-size: 0.85rem;
  }

  .spot-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .spot-card {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    padding: 14px 16px;
    border: 1px solid #e3e9e5;
    border-radius: 13px;
    background: #fff;
    color: inherit;
    font: inherit;
    font-weight: 650;
    text-align: left;
    cursor: pointer;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .spot-card:hover,
  .spot-card:focus-visible {
    border-color: #9ab5a4;
    box-shadow: 0 4px 14px rgb(34 58 47 / 8%);
  }

  .spot-card:focus-visible {
    outline: 3px solid #7da78e;
    outline-offset: 2px;
  }

  .spot-city {
    margin-left: auto;
    color: #78847e;
    font-size: 0.8rem;
    font-weight: 500;
  }

  @media (max-width: 720px) {
    .spots-page {
      width: min(100% - 28px, 560px);
      margin-top: 32px;
    }

    .map-card {
      padding: 10px;
    }
  }
</style>
