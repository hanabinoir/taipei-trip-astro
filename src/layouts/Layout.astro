---
interface Props {
  title: string;
  currentPage: "overview" | "spots" | "transportation" | "experiences";
}

const { title, currentPage } = Astro.props;

const tabs = [
  { id: "overview", label: "Overview", href: "/" },
  { id: "spots", label: "Spots", href: "/spots" },
  { id: "transportation", label: "Transportation", href: "/transportation" },
  { id: "experiences", label: "My Experiences", href: "/experiences" },
] as const;
---
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="北台灣旅行首頁">北台灣旅行</a>

      <div class="header-tools">
        <nav class="tabs" aria-label="主要導覽">
          {tabs.map((tab) => (
            <a
              href={tab.href}
              class:list={["tab", { active: currentPage === tab.id }]}
              aria-current={currentPage === tab.id ? "page" : undefined}
            >
              {tab.label}
            </a>
          ))}
        </nav>

        <button class="language-toggle" type="button" aria-label="切換語言" title="正體中文 / 日本語">
          <span class="language-icon" aria-hidden="true">🇹🇼</span>
          <span class="language-label">正體中文</span>
        </button>
      </div>
    </header>
    <slot />
  </body>

  <script is:inline>
    const languageOptions = {
      "zh-TW": "正體中文",
      ja: "日本語",
    };

    const setLanguageButton = (language) => {
      const button = document.querySelector(".language-toggle");
      if (!button) return;

      const label = button.querySelector(".language-label");
      const nextLanguage = languageOptions[language] || languageOptions["zh-TW"];
      const flag = language === "ja" ? "🇯🇵" : "🇹🇼";
      const icon = button.querySelector(".language-icon");
      if (icon) icon.textContent = flag;
      if (label) label.textContent = nextLanguage;
      button.setAttribute("aria-label", `切換語言，目前為 ${nextLanguage}`);
      button.title = `目前語言：${nextLanguage}`;
      document.documentElement.lang = language === "ja" ? "ja" : "zh-Hant";
    };

    const getStoredLanguage = () => {
      const saved = localStorage.getItem("trip-language");
      return saved === "ja" ? "ja" : "zh-TW";
    };

    const currentLanguage = getStoredLanguage();
    setLanguageButton(currentLanguage);

    window.addEventListener("language-change", (event) => {
      const nextLanguage = event.detail?.language || getStoredLanguage();
      setLanguageButton(nextLanguage);
    });

    document.addEventListener("DOMContentLoaded", () => {
      const button = document.querySelector(".language-toggle");
      if (!button) return;

      button.addEventListener("click", () => {
        const nextLanguage = getStoredLanguage() === "ja" ? "zh-TW" : "ja";
        localStorage.setItem("trip-language", nextLanguage);
        setLanguageButton(nextLanguage);
        window.dispatchEvent(new CustomEvent("language-change", { detail: { language: nextLanguage } }));
      });
    });
  </script>
</html>

<style is:global>
  :root {
    font-family: Inter, "Noto Sans TC", "PingFang TC", sans-serif;
    color: #263a32;
    background: #f7f8f5;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
  }

  a {
    color: inherit;
  }
</style>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
    padding: 12px max(24px, calc((100% - 1080px) / 2));
    border-bottom: 1px solid #e6eae5;
    background: rgb(255 255 255 / 92%);
  }

  .brand {
    flex: 0 0 auto;
    color: #1d3029;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .tabs {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tab {
    padding: 10px 14px;
    border-radius: 999px;
    color: #69766f;
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .tab:hover {
    color: #1d3029;
    background: #f0f3ef;
  }

  .tab.active {
    color: #fff;
    background: #315d4a;
  }

  .language-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border: 1px solid #dfe7e1;
    border-radius: 999px;
    background: #f7faf7;
    color: #1d3029;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .language-toggle:hover {
    border-color: #b9cabf;
    background: #edf3ee;
    transform: translateY(-1px);
  }

  .language-icon {
    display: inline-flex;
    font-size: 1rem;
  }

  .tab:focus-visible,
  .brand:focus-visible,
  .language-toggle:focus-visible {
    outline: 3px solid #7da78e;
    outline-offset: 3px;
  }

  @media (max-width: 720px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
      padding: 16px 14px 0;
    }

    .header-tools {
      width: 100%;
      justify-content: space-between;
      gap: 8px;
    }

    .tabs {
      width: 100%;
      gap: 2px;
      overflow-x: auto;
      padding-bottom: 10px;
    }

    .tab {
      padding: 9px 12px;
      font-size: 0.82rem;
    }

    .language-toggle {
      flex-shrink: 0;
    }
  }
</style>